# Wayfinder local full-integration profile (non-secret settings)
# Copy to: .env.local.integration

NODE_ENV=development
PORT=3000

# Local Redis (docker-compose.local-integration.yml)
REDIS_ENABLED=true
REDIS_URL=redis://localhost:6379

# Security / auth
ALLOWED_ORIGINS=http://localhost:3000
FEATURE_USER_SELF_SERVICE=true

# Router providers enabled for real routing integration
ROUTER_LLM_OPENAI_ENABLED=true
ROUTER_LLM_OPENAI_MODEL=gpt-4-turbo
ROUTER_LLM_GEMINI_ENABLED=true
ROUTER_LLM_GEMINI_MODEL=gemini-2.5-flash
ROUTER_LLM_TIMEOUT=30000
ROUTER_LLM_MAX_RETRIES=2
ROUTER_LLM_TEMPERATURE=0
ROUTER_LLM_MAX_TOKENS=2000

# LangCache integration testing
LANGCACHE_ENABLED=true
LANGCACHE_INTEGRATION_TEST=true
LANGCACHE_SIMILARITY_THRESHOLD=0.9
LANGCACHE_TTL=3600
LANGCACHE_TIMEOUT_MS=5000

# Optional: email link target used in registration/password-reset flows
FRONTEND_BASE_URL=http://localhost:3000
