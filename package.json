{
  "name": "wayfinder",
  "version": "0.1.0",
  "description": "AI navigation and routing service that directs user intent to the appropriate LLM based on policy, trust preferences, and evolving knowledge",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "start:prod": "NODE_ENV=production node dist/server.js",
    "prod": "npm run build && npm run start:prod",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:cache": "vitest run test/cache",
    "test:cache:watch": "vitest test/cache",
    "test:cache:integration": "LANGCACHE_INTEGRATION_TEST=true vitest run test/cache/langcache-integration.test.ts",
    "test:integration:local-full": "bash -c 'set -a && source .env.local.integration && source .env.local.secrets && set +a && WAYFINDER_LOCAL_FULL_ENV_LOADED=true bash scripts/local-full-check.sh && npm test'",
    "local:deps:up": "docker compose -f docker-compose.local-integration.yml up -d redis",
    "local:deps:down": "docker compose -f docker-compose.local-integration.yml down",
    "local:full:check": "bash scripts/local-full-check.sh",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "typecheck": "tsc --noEmit",
    "validate": "npm run lint && npm test",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "ai",
    "llm",
    "routing",
    "navigation",
    "policy"
  ],
  "license": "AGPL-3.0-only",
  "dependencies": {
    "@google-cloud/opentelemetry-cloud-monitoring-exporter": "^0.21.0",
    "@google-cloud/opentelemetry-cloud-trace-exporter": "^3.0.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.68.0",
    "@opentelemetry/sdk-metrics": "^2.5.0",
    "@opentelemetry/sdk-node": "^0.211.0",
    "@redis-ai/langcache": "^0.11.1",
    "@types/bcrypt": "^6.0.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^4.18.2",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "ioredis": "^5.3.2",
    "rate-limit-redis": "^4.3.1",
    "uuid": "^9.0.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/helmet": "^0.0.48",
    "@types/node": "^20.10.0",
    "@types/supertest": "^2.0.16",
    "@types/uuid": "^9.0.7",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "eslint": "^8.54.0",
    "ioredis-mock": "^8.13.1",
    "supertest": "^6.3.3",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.2",
    "vitest": "^1.6.1"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
