# Wayfinder local full-integration profile (secrets)
# Copy to: .env.local.secrets
# Do not commit this file with real values.

# Admin auth
ADMIN_API_KEY=local-dev-admin-key

# LLM provider API keys
ROUTER_LLM_OPENAI_API_KEY=sk-...
ROUTER_LLM_GEMINI_API_KEY=AIza...

# LangCache credentials
LANGCACHE_HOST=your-cache-id.langcache.redis.io
LANGCACHE_CACHE_ID=your-cache-id
LANGCACHE_API_KEY=your-langcache-api-key

# BYOLLM encryption key (64 hex chars)
LLM_KEY_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Email provider (optional for local integration unless testing mail delivery)
POSTMARK_API_KEY=postmark-server-token
