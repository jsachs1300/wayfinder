# Wayfinder Configuration

# Server
PORT=3000
NODE_ENV=development

# Security - CORS (Cross-Origin Resource Sharing)
# Comma-separated list of allowed origins (default: * allows all origins)
# In production, specify exact origins: https://app.example.com,https://admin.example.com
ALLOWED_ORIGINS=*

# Admin Authentication
ADMIN_API_KEY=your-admin-api-key-here

# Redis Configuration
REDIS_URL=redis://localhost:6379
REDIS_ENABLED=true

# Knowledge Store
KNOWLEDGE_DECAY_RATE=0.05
KNOWLEDGE_DECAY_INTERVAL_HOURS=24
MIN_VOTES_FOR_STRONG_CONFIDENCE=5

# Logging
LOG_LEVEL=info

# Router LLM Configuration
# Provider: 'openai' or 'anthropic'
ROUTER_LLM_PROVIDER=openai
# API key for the router LLM provider (REQUIRED for real routing)
ROUTER_LLM_API_KEY=your-router-llm-api-key-here
# Model to use for routing decisions
ROUTER_LLM_MODEL=gpt-4o-mini
# Request timeout in milliseconds
ROUTER_LLM_TIMEOUT=10000
# Maximum retry attempts on failure
ROUTER_LLM_MAX_RETRIES=2
# Temperature for LLM sampling (0.0 = deterministic)
ROUTER_LLM_TEMPERATURE=0.0
# Maximum tokens in LLM response
ROUTER_LLM_MAX_TOKENS=500

# Rate Limiting (prevents abuse and cost overruns)
# All limits are OPTIONAL - defaults provided below

# Global rate limit (applies to all endpoints unless overridden)
# Default: 100 requests per 15 minutes
RATE_LIMIT_GLOBAL_WINDOW_MS=900000
RATE_LIMIT_GLOBAL_MAX=100

# Routing endpoint rate limit (per token, most critical due to LLM costs)
# Default: 20 requests per minute (conservative to prevent cost overruns)
# Increase based on your expected usage and budget
RATE_LIMIT_ROUTING_WINDOW_MS=60000
RATE_LIMIT_ROUTING_MAX=20

# Admin endpoints rate limit (per IP)
# Default: 50 requests per 15 minutes
RATE_LIMIT_ADMIN_WINDOW_MS=900000
RATE_LIMIT_ADMIN_MAX=50

# Feedback endpoint rate limit (per token)
# Default: 100 requests per 15 minutes
RATE_LIMIT_FEEDBACK_WINDOW_MS=900000
RATE_LIMIT_FEEDBACK_MAX=100

# Semantic Caching with LangCache (OPTIONAL - improves performance and reduces costs)
# Enable semantic caching to cache routing decisions based on semantic similarity
# This can significantly reduce router LLM API calls and improve response times
# Requires a LangCache instance (Redis Cloud managed service)
# Learn more: https://redis.io/docs/latest/develop/ai/langcache/

# Enable/disable semantic caching (default: false)
LANGCACHE_ENABLED=false

# LangCache API configuration (required if LANGCACHE_ENABLED=true)
# Get these from your LangCache console: https://redis.io/langcache/
LANGCACHE_HOST=your-cache-id.langcache.redis.io
LANGCACHE_CACHE_ID=your-cache-id
LANGCACHE_API_KEY=your-langcache-api-key

# Semantic similarity threshold (0.0 - 1.0, default: 0.9)
# Higher values = more strict matching (only very similar prompts return cache hits)
# Lower values = more lenient matching (more cache hits, but potentially less precise)
# Recommended: 0.85 - 0.95 for production use
LANGCACHE_SIMILARITY_THRESHOLD=0.9

# Cache entry TTL in seconds (default: 3600 = 1 hour)
# How long cached routing decisions remain valid
# Adjust based on your model update frequency and caching needs
LANGCACHE_TTL=3600

# Cache operation timeout in milliseconds (default: 5000 = 5 seconds)
# Prevents slow cache operations from blocking routing requests
# Increase if you experience frequent cache timeouts on slow connections
LANGCACHE_TIMEOUT_MS=5000

# User Authentication & BYOLLM (Bring Your Own LLM) Features
# These features are OPTIONAL and disabled by default
# Enable them to allow users to register, manage tokens, and provide their own LLM API keys

# Feature Flag: Enable user self-service features (default: false)
# When enabled, users can:
# - Register and login with email/password
# - Create and manage their own tokens (up to MAX_TOKENS_PER_USER)
# - Provide their own OpenAI/Gemini API keys (BYOLLM tier)
# - Start with anonymous sessions and upgrade to registered accounts
FEATURE_USER_SELF_SERVICE=false

# LLM Key Encryption (REQUIRED if FEATURE_USER_SELF_SERVICE=true and BYOLLM is used)
# 64 hex characters (32 bytes) for AES-256-GCM encryption of user LLM API keys
# Generate with: openssl rand -hex 32
# CRITICAL: Keep this secret and back it up securely - lost key = lost user LLM keys
LLM_KEY_ENCRYPTION_KEY=your-64-char-hex-encryption-key-here

# Rate Limits per User Tier (OPTIONAL - defaults shown)
# Free tier: Limited requests, system pays LLM costs
RATE_LIMIT_FREE_HOUR=10
RATE_LIMIT_FREE_DAY=50
RATE_LIMIT_FREE_BURST=5

# Paid System tier: Higher limits, system pays LLM costs
RATE_LIMIT_PAID_SYSTEM_HOUR=100
RATE_LIMIT_PAID_SYSTEM_DAY=1000
RATE_LIMIT_PAID_SYSTEM_BURST=20

# Paid BYOLLM tier: Highest limits, user provides own LLM API keys
RATE_LIMIT_BYOLLM_HOUR=1000
RATE_LIMIT_BYOLLM_DAY=-1
RATE_LIMIT_BYOLLM_BURST=100

# User Limits (OPTIONAL - defaults shown)
# Maximum tokens a user can create (default: 10)
MAX_TOKENS_PER_USER=10

# Anonymous session TTL in days (default: 7)
# How long anonymous sessions last before requiring registration
ANONYMOUS_SESSION_TTL_DAYS=7
